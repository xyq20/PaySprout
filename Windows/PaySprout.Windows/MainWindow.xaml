<Window x:Class="PaySprout.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PaySprout"
 Title="薪芽 · 上班鼓励器" Width="660" Height="392" WindowStyle="None" ResizeMode="CanResizeWithGrip" AllowsTransparency="True" Background="Transparent" Topmost="True" Icon="AppIcon.ico" FontFamily="Microsoft YaHei UI, Segoe UI" FontSize="12" WindowStartupLocation="CenterScreen">
 <Border x:Name="Shell" Margin="5" Background="{DynamicResource Canvas}" BorderBrush="{DynamicResource Line}" BorderThickness="1" CornerRadius="20" Padding="18">
  <Grid>
   <Viewbox x:Name="FullBox" Stretch="Uniform">
    <Grid Width="600" Height="330">
     <Grid.RowDefinitions><RowDefinition Height="40"/><RowDefinition Height="160"/><RowDefinition Height="100"/><RowDefinition Height="30"/></Grid.RowDefinitions>
     <Grid Grid.Row="0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel Orientation="Horizontal" MouseLeftButtonDown="DragTitle" Cursor="Hand" Background="Transparent" ToolTip="按住标题拖动窗口">
       <TextBlock Text="薪芽" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/>
       <TextBlock Text="每一分努力，都在悄悄发芽。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="12,0,0,0" VerticalAlignment="Center"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
       <Button Content="✧" Click="PreviewClick" ToolTip="预览下班彩蛋" AutomationProperties.Name="预览下班彩蛋"/>
       <Button Content="AA" Click="SizeClick" ToolTip="调整大小" AutomationProperties.Name="调整大小"/>
       <Button Content="▱" Click="CompactClick" ToolTip="紧凑模式" AutomationProperties.Name="切换紧凑模式"/>
       <Button Content="⚙" Click="SettingsClick" ToolTip="偏好设置 Ctrl+," AutomationProperties.Name="偏好设置"/>
       <Button Content="−" Click="HideClick" ToolTip="收起到系统托盘" AutomationProperties.Name="收起到系统托盘"/>
       <Button Content="×" Click="ExitClick" ToolTip="退出" AutomationProperties.Name="退出薪芽"/>
      </StackPanel>
     </Grid>
     <Grid Grid.Row="1" Margin="0,8,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="245"/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Background="{DynamicResource Surface}" CornerRadius="18" Padding="18">
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="今日已赚" Foreground="{DynamicResource Muted}"/>
        <Viewbox Stretch="Uniform" StretchDirection="DownOnly" HorizontalAlignment="Left" Height="47"><TextBlock x:Name="Amount" Text="¥0.0000" FontSize="35" FontWeight="Medium" AutomationProperties.Name="今日已赚"/></Viewbox>
        <TextBlock x:Name="TargetText" Margin="0,5,0,0"/>
        <TextBlock x:Name="RateText" Foreground="{DynamicResource Accent}" FontSize="11" Margin="0,6,0,0"/>
       </StackPanel>
      </Border>
      <Border Grid.Column="2" Background="{DynamicResource Surface}" CornerRadius="18" Padding="18">
       <StackPanel VerticalAlignment="Center">
        <TextBlock x:Name="CountdownTitle" Text="下班倒数" Foreground="{DynamicResource Muted}"/>
        <TextBlock x:Name="CountdownText" FontSize="26" FontWeight="Medium" Margin="0,9,0,8"/>
        <ProgressBar x:Name="Progress" Height="6" Maximum="1" Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}" BorderThickness="0" AutomationProperties.Name="班次进度"/>
        <TextBlock x:Name="ProgressText" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,8,0,0"/>
        <Button x:Name="EndPreview" Content="结束预览" HorizontalAlignment="Left" Visibility="Collapsed" Click="PreviewClick" Padding="0,4"/>
       </StackPanel>
      </Border>
     </Grid>
     <Border Grid.Row="2" CornerRadius="16" Background="{DynamicResource Surface}" Margin="0,12,0,0" Padding="12,0">
      <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="84"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <local:SproutView x:Name="Buddy" Width="78" Height="78" MouseLeftButtonUp="CheerClick" Cursor="Hand" ToolTip="摸摸小薪芽，收下一句鼓励" AutomationProperties.Name="小薪芽"/>
       <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock x:Name="StageText" FontWeight="SemiBold" FontSize="14"/><TextBlock x:Name="QuoteText" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,7,10,0" FontSize="11"/></StackPanel>
       <Button x:Name="BreakButton" Grid.Column="2" Content="带薪充电" Click="BreakClick" VerticalAlignment="Center" Background="#E8F2E8" Foreground="#3D6E54"/>
      </Grid>
     </Border>
     <TextBlock Grid.Row="3" Text="按班次估算 · 休息时收入也在生长" FontSize="10" Foreground="{DynamicResource Muted}" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
    </Grid>
   </Viewbox>
   <Viewbox x:Name="CompactBox" Visibility="Collapsed" Stretch="Uniform">
    <Grid Width="380" Height="70" Background="Transparent" MouseLeftButtonDown="DragTitle">
     <Grid.ColumnDefinitions><ColumnDefinition Width="62"/><ColumnDefinition Width="135"/><ColumnDefinition/><ColumnDefinition Width="36"/></Grid.ColumnDefinitions>
     <local:SproutView x:Name="CompactBuddy" Width="58" Height="64" MouseLeftButtonUp="CheerClick" Cursor="Hand"/>
     <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="今日已赚" Foreground="{DynamicResource Muted}" FontSize="11"/><TextBlock x:Name="CompactAmount" FontSize="23" FontWeight="Medium"/></StackPanel>
     <StackPanel Grid.Column="2" VerticalAlignment="Center"><TextBlock x:Name="CompactCountdown" FontSize="11"/><ProgressBar x:Name="CompactProgress" Maximum="1" Height="5" Margin="0,9,8,0" Foreground="{DynamicResource Accent}" Background="{DynamicResource Line}" BorderThickness="0"/></StackPanel>
     <StackPanel Grid.Column="3" VerticalAlignment="Center"><Button Content="↗" Click="CompactClick" ToolTip="展开完整模式" AutomationProperties.Name="展开完整模式"/><Button Content="…" Click="MoreClick" ToolTip="更多选项" AutomationProperties.Name="更多选项"/></StackPanel>
    </Grid>
   </Viewbox>
   <Viewbox x:Name="SettingsBox" Stretch="Uniform" Visibility="Collapsed">
    <Grid Width="600" Height="330">
     <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition/><RowDefinition Height="50"/></Grid.RowDefinitions>
     <TextBlock Text="让薪芽了解你的工作日" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <StackPanel Grid.Row="1" Margin="0,12,0,0">
      <Label Content="日薪（元）" Target="{Binding ElementName=PayInput}" Foreground="{DynamicResource Ink}"/>
      <TextBox x:Name="PayInput" AutomationProperties.Name="日薪"/>
      <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="20"/><ColumnDefinition/></Grid.ColumnDefinitions>
       <StackPanel><Label Content="上班时间（HH:mm）" Target="{Binding ElementName=StartInput}" Foreground="{DynamicResource Ink}"/><TextBox x:Name="StartInput" AutomationProperties.Name="上班时间"/></StackPanel>
       <StackPanel Grid.Column="2"><Label Content="下班时间（HH:mm）" Target="{Binding ElementName=EndInput}" Foreground="{DynamicResource Ink}"/><TextBox x:Name="EndInput" AutomationProperties.Name="下班时间"/></StackPanel>
      </Grid>
      <TextBlock x:Name="SettingsError" Foreground="#B83E37" TextWrapping="Wrap" Margin="0,12,0,0"/>
      <TextBlock Text="支持跨午夜班次。收入包含班次内休息，不代表实际结算工资。" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,8,0,0"/>
     </StackPanel>
     <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom"><Button Content="取消" Click="CancelSettings" Margin="0,0,12,0"/><Button Content="保存设置" Click="SaveSettings" Background="#E8F2E8" Foreground="#3D6E54"/></StackPanel>
    </Grid>
   </Viewbox>
   <local:FireworksView x:Name="Fireworks" IsHitTestVisible="False"/>
  </Grid>
 </Border>
</Window>
